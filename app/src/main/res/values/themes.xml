<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all real theming (see ui/theme/Theme.kt). This is just the launch/window
         theme Android needs before the first Compose frame draws. -->
    <style name="Theme.OpenZilla" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
